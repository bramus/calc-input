{
  "name": "calc-input",
  "version": "1.0.1",
  "description": "A custom input element that accepts mathematical formulas",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "generate-screenshot": "node scripts/generate-screenshot.js",
    "generate-video": "node scripts/generate-video.js",
    "prepublishOnly": "if [ -z $PUBLISH ]; then echo 'This package must be published using `npm run pub`\\n' && exit 1; fi",
    "pub": "PUBLISH=true npm run build && npm publish ./dist",
    "start": "npx -y serve src",
    "dev": "npx -y serve src",
    "deploy": "netlify deploy --dir=src --prod",
    "deploy:preview": "netlify deploy --dir=src",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:e2e": "node --test tests/e2e/**/*.test.js"
  },
  "keywords": [
    "calc-input",
    "custom-element",
    "web-components",
    "formula",
    "calculator-input",
    "math-input",
    "form-input"
  ],
  "author": {
    "name": "Bramus Van Damme",
    "email": "bramus@bram.us",
    "url": "https://www.bram.us/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bramus/calc-input.git"
  },
  "bugs": {
    "url": "https://github.com/bramus/calc-input/issues"
  },
  "homepage": "https://calc-input.netlify.app/",
  "devDependencies": {
    "puppeteer": "^25.11.0"
  }
}
